{
  "$schema": "https://schemas.reservas.local/design-tokens/v1.json",
  "version": "0.1.0",
  "color": {
    "navy": "#17355F",
    "blue": "#2376A8",
    "teal": "#148A7B",
    "amber": "#D9921E",
    "ink": "#1D2A36",
    "muted": "#5E6C78",
    "paper": "#F4F1E8",
    "surface": "#FFFFFF",
    "border": "#D8DFE5",
    "danger": "#B74343",
    "focus": "#F2B84B"
  },
  "font": {
    "display": "Georgia, 'Times New Roman', serif",
    "body": "Aptos, 'Avenir Next', 'Segoe UI', sans-serif",
    "mono": "'SFMono-Regular', Consolas, monospace"
  },
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "6": 24,
    "8": 32,
    "12": 48,
    "16": 64
  },
  "radius": {
    "small": 6,
    "medium": 12,
    "large": 20,
    "pill": 999
  },
  "shadow": {
    "surface": "0 10px 28px rgba(23, 53, 95, 0.08)",
    "floating": "0 18px 42px rgba(23, 53, 95, 0.16)"
  },
  "breakpoint": {
    "tablet": 769,
    "desktop": 1024,
    "widescreen": 1216
  },
  "motion": {
    "fast": 120,
    "normal": 220,
    "slow": 360
  }
}
